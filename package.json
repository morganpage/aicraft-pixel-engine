{
  "name": "aicraft-pixel-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Pixel-based falling-sand cellular-automaton physics engine for AI Craft games. Zero runtime dependencies.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepack": "npm run build:dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:typecheck": "tsc --noEmit --project showcase/tsconfig.json",
    "showcase:test": "vitest run --config showcase/vitest.config.ts",
    "showcase:test:watch": "vitest --config showcase/vitest.config.ts"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
