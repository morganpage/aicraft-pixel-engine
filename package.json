{
  "name": "aicraft-pixel-engine",
  "version": "0.1.2",
  "type": "module",
  "description": "Pixel-based falling-sand cellular-automaton physics engine for AI Craft games. Zero runtime dependencies.",
  "license": "MIT",
  "author": "AI Craft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morganpage/aicraft-pixel-engine.git"
  },
  "homepage": "https://github.com/morganpage/aicraft-pixel-engine#readme",
  "bugs": {
    "url": "https://github.com/morganpage/aicraft-pixel-engine/issues"
  },
  "keywords": [
    "falling-sand",
    "cellular-automaton",
    "physics-engine",
    "pixel",
    "simulation",
    "game",
    "deterministic"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepack": "npm run build:dist",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:typecheck": "tsc --noEmit --project showcase/tsconfig.json",
    "showcase:test": "vitest run --config showcase/vitest.config.ts",
    "showcase:test:watch": "vitest --config showcase/vitest.config.ts",
    "showcase:test:scenario": "vitest run --config showcase/vitest.scenario.config.ts",
    "showcase:test:all": "npm run showcase:test && npm run showcase:test:scenario"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
