# Dependencies — regenerated by `npm install`.
node_modules/

# Build output — regenerated by `npm run build:dist`.
dist/

# Showcase build output — regenerated by `npm run showcase:build`.
showcase/dist/

# OS / editor cruft.
.DS_Store
*.local
.vite/
coverage/

# Editor / agent working state — not project source.
.zcode/
.claude/

# Secrets — never commit.
.env
.env.*
!.env.example
