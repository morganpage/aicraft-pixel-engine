# Dependencies — regenerated by `npm install`.
node_modules/

# Build output — regenerated by `npm run build:dist`.
dist/

# Showcase build output — regenerated by `npm run showcase:build`.
showcase/dist/

# OS / editor cruft.
.DS_Store
*.local
.vite/
coverage/

# Editor / agent working state — not project source.
.zcode/
.scratch/

# Agent config: `launch.json` is shared project config (how to run the showcase
# dev server) and belongs in the repo. Only the per-machine settings are local.
.claude/*
!.claude/launch.json

# Secrets — never commit.
.env
.env.*
!.env.example
